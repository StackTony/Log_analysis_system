# Flask配置
FLASK_CONFIG=development
SECRET_KEY=your-secret-key-here

# 数据库配置
# MySQL连接字符串格式：mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/log_analysis

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017/log_analysis

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-here

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 服务配置
HOST=0.0.0.0
PORT=5000

# DeepSeek API配置（用于AI分析）
DEEPSEEK_API_KEY=your-deepseek-api-key-here